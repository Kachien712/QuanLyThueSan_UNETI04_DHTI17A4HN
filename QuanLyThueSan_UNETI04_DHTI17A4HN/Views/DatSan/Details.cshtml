@* 
    Họ và tên: Đào Đức Kiên
    Mã sinh viên: 23103100222
    Nội dung thực hiện: Module 3 - Giao diện chi tiết đơn đặt sân (Commit 11 & 12) & Hủy đặt sân (Commit 13)
    - Hiển thị đầy đủ thông tin: Sân thể thao, giờ thuê, khách hàng, thông tin dịch vụ kèm theo
    - Kiểm tra điều kiện hủy đơn: chỉ cho phép hủy khi trạng thái "Chờ xác nhận" và trước giờ bắt đầu >= 2 tiếng
*@
@model QuanLyThueSan_UNETI04_DHTI17A4HN.Models.DatSan

@{
    ViewData["Title"] = "Chi tiết đơn đặt sân #" + Model.MaDatSan;

    string badgeClass = Model.TrangThai switch
    {
        "Chờ xác nhận" => "bg-warning text-dark",
        "Đã xác nhận" => "bg-info text-dark",
        "Đang sử dụng" => "bg-success",
        "Chờ thanh toán" => "bg-secondary",
        "Hoàn thành" => "bg-primary",
        "Đã hủy" => "bg-danger",
        _ => "bg-light text-dark"
    };

    // Điều kiện hủy từ ViewBag (hoặc fallback tính toán trực tiếp)
    bool choPhepKhachHuy = ViewBag.ChoPhepKhachHuy ?? 
        (Model.TrangThai == "Chờ xác nhận" && (Model.NgaySuDung.Date.Add(Model.GioBatDau) - DateTime.Now >= TimeSpan.FromHours(2)));
    string? lyDoKhongChoHuy = ViewBag.LyDoKhongChoHuy;

    double thoiLuongGio = Math.Round((Model.GioKetThuc - Model.GioBatDau).TotalHours, 2);
}

<div class="container-fluid px-0">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="LichSuDatSan">Lịch sử đặt sân</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết đơn #@Model.MaDatSan</li>
        </ol>
    </nav>

    <!-- Thông báo kết quả thao tác -->
    @if (TempData["ThanhCong"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-2 py-3 px-3 shadow-sm border-0 border-start border-4 border-success mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-4 text-success me-3"></i>
                <div>
                    <strong>Thành công!</strong> @TempData["ThanhCong"]
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Loi"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-2 py-3 px-3 shadow-sm border-0 border-start border-4 border-danger mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-4 text-danger me-3"></i>
                <div>
                    <strong>Lỗi:</strong> @TempData["Loi"]
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Thẻ tiêu đề và trạng thái đơn -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h3 class="fw-bold text-dark mb-0">Đơn đặt sân #@Model.MaDatSan</h3>
                    <span class="badge @badgeClass fs-6 px-3 py-1 rounded-pill">@Model.TrangThai</span>
                </div>
                <p class="text-muted mb-0">
                    <i class="bi bi-calendar-event"></i> Ngày tạo đơn: <strong>@Model.NgayDat.ToString("HH:mm:ss dd/MM/yyyy")</strong>
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="LichSuDatSan" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Lịch sử đặt sân
                </a>
                <a asp-action="Create" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Đặt thêm đơn khác
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- CỘT TRÁI: THÔNG TIN SÂN & THỜI GIAN THUÊ -->
        <div class="col-lg-7">
            <!-- Thẻ 1: Thông tin sân & Khung giờ -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold text-primary mb-0">
                        <i class="bi bi-geo-alt-fill"></i> Thông tin sân & Thời gian đặt lịch
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Sân thể thao</small>
                            <span class="fw-bold fs-5 text-dark">@(Model.SanTheThao?.TenSan ?? "Sân #" + Model.MaSan)</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Phân loại & Vị trí</small>
                            <span class="badge bg-info text-dark">@(Model.SanTheThao?.LoaiSan?.TenLoaiSan ?? "Tiêu chuẩn")</span>
                            <span class="badge bg-secondary">@(Model.SanTheThao?.KhuVuc?.TenKhuVuc ?? "Chưa phân khu")</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Ngày sử dụng</small>
                            <strong class="text-primary fs-6">@Model.NgaySuDung.ToString("dd/MM/yyyy")</strong>
                            <small class="text-muted d-block">(@Model.NgaySuDung.ToString("dddd", new System.Globalization.CultureInfo("vi-VN")))</small>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Khung giờ thuê sân</small>
                            <strong class="fs-6">@Model.GioBatDau.ToString(@"hh\:mm") - @Model.GioKetThuc.ToString(@"hh\:mm")</strong>
                            <small class="text-muted">(@thoiLuongGio giờ)</small>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Số người tham gia</small>
                            <span><strong>@Model.SoNguoi</strong> người (Sức chứa tối đa: @(Model.SanTheThao?.SucChua ?? 0) người)</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Thời điểm nhận sân thực tế</small>
                            <span>@(Model.ThoiDiemNhanSanThucTe.HasValue ? Model.ThoiDiemNhanSanThucTe.Value.ToString("HH:mm dd/MM/yyyy") : "Chưa nhận sân")</span>
                        </div>
                        <div class="col-12">
                            <small class="text-muted d-block">Ghi chú yêu cầu của khách</small>
                            <p class="mb-0 text-secondary fst-italic bg-light p-3 rounded mt-1">
                                @(string.IsNullOrWhiteSpace(Model.GhiChu) ? "Không có ghi chú thêm." : Model.GhiChu)
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thẻ 2: Thông tin dịch vụ kèm theo (Commit 11 & 12) -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-box-seam text-primary"></i> Dịch vụ kèm theo
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.SuDungDichVus != null && Model.SuDungDichVus.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>STT</th>
                                        <th>Tên dịch vụ</th>
                                        <th class="text-center">Số lượng</th>
                                        <th class="text-end">Đơn giá</th>
                                        <th class="text-end">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int stt = 1; }
                                    @foreach (var dv in Model.SuDungDichVus)
                                    {
                                        <tr>
                                            <td>@(stt++)</td>
                                            <td class="fw-semibold">@(dv.DichVu?.TenDichVu ?? "Dịch vụ #" + dv.MaDichVu)</td>
                                            <td class="text-center">@dv.SoLuong @(dv.DichVu?.DonViTinh ?? "")</td>
                                            <td class="text-end">@dv.DonGia.ToString("N0") VNĐ</td>
                                            <td class="text-end fw-semibold text-primary">@dv.ThanhTien.ToString("N0") VNĐ</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-basket3 fs-2 d-block mb-2 text-secondary"></i>
                            <span>Đơn đặt sân này hiện chưa đăng ký dịch vụ kèm theo.</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: KHÁCH HÀNG & THAO TÁC HỦY ĐƠN -->
        <div class="col-lg-5">
            <!-- Thông tin khách hàng (Commit 11 & 12) -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-person-circle text-primary"></i> Thông tin khách hàng
                    </h5>
                </div>
                <div class="card-body p-3">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <small class="text-muted d-block">Họ và tên khách hàng:</small>
                            <span class="fw-bold text-dark fs-6">@(Model.KhachHang?.HoTen ?? "Khách #" + Model.MaKhachHang)</span>
                        </li>
                        <li class="mb-2">
                            <small class="text-muted d-block">Số điện thoại liên hệ:</small>
                            <span class="text-dark"><i class="bi bi-telephone"></i> @(Model.KhachHang?.SoDienThoai ?? "-")</span>
                        </li>
                        <li class="mb-2">
                            <small class="text-muted d-block">Địa chỉ Email:</small>
                            <span class="text-dark"><i class="bi bi-envelope"></i> @(Model.KhachHang?.Email ?? "Chưa cập nhật")</span>
                        </li>
                        <li>
                            <small class="text-muted d-block">Địa chỉ liên hệ:</small>
                            <span class="text-dark">@(Model.KhachHang?.DiaChi ?? "Chưa cập nhật")</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- HÀNH ĐỘNG HỦY ĐƠN (Commit 13) -->
            <div class="card shadow-sm border-0 border-top border-3 @(choPhepKhachHuy ? "border-danger" : "border-secondary")">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-shield-exclamation @(choPhepKhachHuy ? "text-danger" : "text-secondary")"></i> Quản lý trạng thái đơn
                    </h5>
                </div>
                <div class="card-body p-3">
                    <h6 class="fw-bold text-dark mb-2">Quy định hủy đặt sân:</h6>
                    <small class="text-muted d-block mb-3">
                        Khách hàng chỉ được phép hủy đơn khi phiếu đang ở trạng thái <strong>Chờ xác nhận</strong> và phải thực hiện trước thời điểm bắt đầu sử dụng tối thiểu <strong>2 tiếng</strong>.
                    </small>

                    @if (choPhepKhachHuy)
                    {
                        <button type="button" class="btn btn-outline-danger w-100 py-2 fw-semibold"
                                data-bs-toggle="modal" data-bs-target="#modalHuyDonChiTiet">
                            <i class="bi bi-x-circle"></i> Yêu cầu hủy đơn đặt sân này
                        </button>

                        <!-- MODAL HỦY ĐƠN -->
                        <div class="modal fade" id="modalHuyDonChiTiet" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form asp-action="HuyDatSan" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.MaDatSan" />
                                        <div class="modal-header bg-danger text-white py-2">
                                            <h6 class="modal-title fw-bold">
                                                <i class="bi bi-exclamation-triangle-fill"></i> Xác nhận hủy đơn #@Model.MaDatSan
                                            </h6>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <p class="mb-2">
                                                Bạn có chắc chắn muốn hủy đơn đặt sân <strong>@(Model.SanTheThao?.TenSan)</strong> vào ngày <strong>@Model.NgaySuDung.ToString("dd/MM/yyyy")</strong> (@Model.GioBatDau.ToString(@"hh\:mm") - @Model.GioKetThuc.ToString(@"hh\:mm")) không?
                                            </p>
                                            <div class="mb-2">
                                                <label class="form-label small fw-semibold">Lý do hủy đơn:</label>
                                                <textarea name="lyDoHuy" class="form-control" rows="3" placeholder="Nhập lý do hủy (VD: Bận việc đột xuất, thay đổi lịch thi đấu...)" required></textarea>
                                            </div>
                                            <small class="text-danger fst-italic">Lưu ý: Chỉ hủy được trước giờ bắt đầu tối thiểu 2 tiếng. Sau khi hủy sẽ không thể hoàn tác.</small>
                                        </div>
                                        <div class="modal-footer py-2">
                                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                                            <button type="submit" class="btn btn-danger btn-sm px-3">Xác nhận hủy đơn</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                    else if (Model.TrangThai == "Đã hủy")
                    {
                        <div class="alert alert-danger mb-0 py-2 small">
                            <i class="bi bi-info-circle"></i> Đơn đặt sân này hiện đã ở trạng thái <strong>Đã hủy</strong>.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border mb-0 py-2 small text-muted">
                            <i class="bi bi-lock"></i> @(lyDoKhongChoHuy ?? $"Đơn đang ở trạng thái '{Model.TrangThai}', không thể hủy theo quy định.")
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
