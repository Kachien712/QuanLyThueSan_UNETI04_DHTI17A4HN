@*
    Họ và tên: Lê Ngọc Hải Nam
    Mã sinh viên: 23103100219
    Nội dung thực hiện: Module 4 tuần 3 - biểu mẫu thêm/sửa dịch vụ.
*@
@model QuanLyThueSan_UNETI04_DHTI17A4HN.ViewModels.DichVuFormViewModel
@{
    var isEdit = Model.MaDichVu > 0;
    ViewData["Title"] = isEdit ? "Sửa dịch vụ" : "Thêm dịch vụ";
}
<section class="module4-page">
<div class="module4-hero module4-hero-compact">
    <span class="module4-eyebrow"><i class="bi bi-box-seam"></i> Module 4 · Dịch vụ</span>
    <h1>@ViewData["Title"]</h1>
    <p>Thiết lập thông tin bán hàng và số lượng tồn kho của dịch vụ.</p>
</div>
<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.MaDichVu : null)" method="post" class="module4-form-card col-lg-7">
    @Html.AntiForgeryToken()
    <input asp-for="MaDichVu" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="TenDichVu" class="form-label"></label>
        <input asp-for="TenDichVu" class="form-control" />
        <span asp-validation-for="TenDichVu" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DonViTinh" class="form-label"></label>
        <input asp-for="DonViTinh" class="form-control" />
        <span asp-validation-for="DonViTinh" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DonGia" class="form-label"></label>
        <input asp-for="DonGia" class="form-control" min="0" step="0.01" />
        <span asp-validation-for="DonGia" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="SoLuongTon" class="form-label"></label>
        <input asp-for="SoLuongTon" class="form-control" min="0" />
        <span asp-validation-for="SoLuongTon" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="TrangThai" class="form-check-input" />
        <label asp-for="TrangThai" class="form-check-label"></label>
    </div>
    <div class="d-flex gap-2 mt-4"><button class="btn module4-btn-primary" type="submit"><i class="bi bi-check2"></i> Lưu dịch vụ</button>
    <a class="btn module4-btn-outline" asp-action="Index">Quay lại</a></div>
</form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
