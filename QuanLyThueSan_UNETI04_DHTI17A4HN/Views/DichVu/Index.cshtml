@*
    Họ và tên: Lê Ngọc Hải Nam
    Mã sinh viên: 23103100219
    Nội dung thực hiện: Module 4 tuần 3 - danh sách, tìm kiếm và đổi trạng thái dịch vụ.
*@
@model IReadOnlyList<QuanLyThueSan_UNETI04_DHTI17A4HN.Models.DichVu>
@{ ViewData["Title"] = "Danh mục dịch vụ"; }

<section class="module4-page">
<div class="module4-hero module4-hero-compact d-flex justify-content-between align-items-center gap-3">
    <div><span class="module4-eyebrow"><i class="bi bi-box-seam"></i> Module 4 · Dịch vụ</span><h1>Danh mục dịch vụ</h1><p>Quản lý giá bán, tồn kho và trạng thái phục vụ tại sân.</p></div>
    <a class="btn module4-btn-primary flex-shrink-0" asp-action="Create"><i class="bi bi-plus-lg"></i> Thêm dịch vụ</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success module4-alert">@success</div> }
<form method="get" class="module4-filter row g-2 mb-3">
    <div class="col-md-4"><input name="timKiem" value="@ViewBag.TimKiem" class="form-control" placeholder="Tìm tên dịch vụ" /></div>
    <div class="col-md-3">
        <select name="dangHoatDong" class="form-select">
            <option value="">Tất cả trạng thái</option>
            <option value="true" selected="@(ViewBag.DangHoatDong == true)">Đang hoạt động</option>
            <option value="false" selected="@(ViewBag.DangHoatDong == false)">Ngừng hoạt động</option>
        </select>
    </div>
    <div class="col-md-2"><button class="btn module4-btn-outline w-100" type="submit"><i class="bi bi-search"></i> Tìm</button></div>
</form>
<div class="module4-panel table-responsive">
    <table class="table module4-table align-middle mb-0">
        <thead><tr><th>Tên dịch vụ</th><th>Đơn vị</th><th>Đơn giá</th><th>Tồn kho</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TenDichVu</td>
                <td>@item.DonViTinh</td>
                <td>@item.DonGia.ToString("N0") đ</td>
                <td><span class="module4-stock">@(item.SoLuongTon?.ToString() ?? "Không quản lý")</span></td>
                <td><span class="module4-status @(item.TrangThai ? "is-active" : "is-inactive")">@(item.TrangThai ? "Hoạt động" : "Ngừng hoạt động")</span></td>
                <td>
                    <a class="btn module4-btn-outline btn-sm" asp-action="Edit" asp-route-id="@item.MaDichVu"><i class="bi bi-pencil"></i> Sửa</a>
                    <form asp-action="DoiTrangThai" asp-route-id="@item.MaDichVu" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn module4-btn-muted btn-sm" type="submit">@(item.TrangThai ? "Ngừng" : "Kích hoạt")</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6">Không có dịch vụ phù hợp.</td></tr> }
        </tbody>
    </table>
</div>
</section>
