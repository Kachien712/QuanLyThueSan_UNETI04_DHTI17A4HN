@*
    Họ và tên: Lê Ngọc Hải Nam
    Mã sinh viên: 23103100219
    Nội dung thực hiện: Module 4 tuần 3 - danh sách, tìm kiếm và đổi trạng thái dịch vụ.
*@
@model IReadOnlyList<QuanLyThueSan_UNETI04_DHTI17A4HN.Models.DichVu>
@{ ViewData["Title"] = "Danh mục dịch vụ"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Danh mục dịch vụ</h1>
    <a class="btn btn-primary" asp-action="Create">Thêm dịch vụ</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="timKiem" value="@ViewBag.TimKiem" class="form-control" placeholder="Tìm tên dịch vụ" /></div>
    <div class="col-md-3">
        <select name="dangHoatDong" class="form-select">
            <option value="">Tất cả trạng thái</option>
            <option value="true" selected="@(ViewBag.DangHoatDong == true)">Đang hoạt động</option>
            <option value="false" selected="@(ViewBag.DangHoatDong == false)">Ngừng hoạt động</option>
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-outline-primary" type="submit">Tìm</button></div>
</form>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Tên dịch vụ</th><th>Đơn vị</th><th>Đơn giá</th><th>Tồn kho</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TenDichVu</td>
                <td>@item.DonViTinh</td>
                <td>@item.DonGia.ToString("N0") đ</td>
                <td>@(item.SoLuongTon?.ToString() ?? "Không quản lý")</td>
                <td>@(item.TrangThai ? "Hoạt động" : "Ngừng hoạt động")</td>
                <td>
                    <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@item.MaDichVu">Sửa</a>
                    <form asp-action="DoiTrangThai" asp-route-id="@item.MaDichVu" method="post" class="d-inline">
                        <button class="btn btn-outline-secondary btn-sm" type="submit">@(item.TrangThai ? "Ngừng" : "Kích hoạt")</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6">Không có dịch vụ phù hợp.</td></tr> }
        </tbody>
    </table>
</div>
