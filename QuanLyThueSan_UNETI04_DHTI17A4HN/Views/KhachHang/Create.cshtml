@* 
    Họ và tên: Đào Đức Kiên
    Mã sinh viên: 23103100220
    Nội dung thực hiện: Module 3 - Giao diện thêm mới khách hàng
*@
@model QuanLyThueSan_UNETI04_DHTI17A4HN.ViewModels.KhachHangFormViewModel

@{
    ViewData["Title"] = "Thêm mới Khách hàng";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white py-3">
                <h5 class="card-title mb-0">Thêm mới Khách hàng</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="HoTen" class="form-label fw-semibold"></label>
                        <input asp-for="HoTen" class="form-control" placeholder="Nhập họ và tên đầy đủ..." />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SoDienThoai" class="form-label fw-semibold"></label>
                        <input asp-for="SoDienThoai" class="form-control" placeholder="Ví dụ: 0912345678" />
                        <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="Ví dụ: nguyenan@gmail.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DiaChi" class="form-label fw-semibold"></label>
                        <textarea asp-for="DiaChi" class="form-control" rows="2" placeholder="Địa chỉ nơi cư trú..."></textarea>
                        <span asp-validation-for="DiaChi" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="TrangThai" id="flexSwitchTrangThai">
                        <label class="form-check-label fw-semibold" for="flexSwitchTrangThai">Kích hoạt tài khoản ngay</label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                        <button type="submit" class="btn btn-success px-4">Lưu thông tin</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
