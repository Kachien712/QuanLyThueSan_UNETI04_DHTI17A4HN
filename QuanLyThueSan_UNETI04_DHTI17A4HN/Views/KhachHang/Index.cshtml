@* 
    Họ và tên: Đào Đức Kiên
    Mã sinh viên: 23103100220
    Nội dung thực hiện: Module 3 - Giao diện danh sách khách hàng có tìm kiếm, lọc, sắp xếp và phân trang
*@
@model QuanLyThueSan_UNETI04_DHTI17A4HN.ViewModels.KhachHangIndexViewModel

@{
    ViewData["Title"] = "Quản lý Khách hàng";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="text-primary mb-1"><i class="bi bi-people-fill"></i> Quản lý Khách hàng</h2>
            <p class="text-muted mb-0">Tra cứu, quản lý thông tin khách hàng và phân quyền sử dụng hệ thống</p>
        </div>
        <a asp-action="Create" class="btn btn-success">
            + Thêm khách hàng mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>Thông báo:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Thống kê nhanh số lượng -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body py-2">
                    <small>Tổng số khách hàng</small>
                    <h3 class="mb-0 fw-bold">@Model.TongSoKhachHang</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body py-2">
                    <small>Đang hoạt động</small>
                    <h3 class="mb-0 fw-bold">@Model.SoKhachHangHoatDong</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-danger text-white">
                <div class="card-body py-2">
                    <small>Đang bị khóa</small>
                    <h3 class="mb-0 fw-bold">@Model.SoKhachHangBiKhoa</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Thanh Tìm kiếm và Bộ lọc -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <input type="text" name="tuKhoa" value="@Model.TuKhoa" class="form-control" 
                           placeholder="Tìm theo họ tên, số điện thoại, email..." />
                </div>
                <div class="col-md-3">
                    <select name="trangThaiFilter" asp-items="Model.DanhSachTrangThai" class="form-select"></select>
                </div>
                <div class="col-md-2">
                    <select name="sortOrder" class="form-select">
                        <option value="">-- Sắp xếp --</option>
                        <option value="name_asc" selected="@(Model.SortOrder == "name_asc")">Tên (A -> Z)</option>
                        <option value="name_desc" selected="@(Model.SortOrder == "name_desc")">Tên (Z -> A)</option>
                        <option value="phone" selected="@(Model.SortOrder == "phone")">Số điện thoại</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách khách hàng -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 80px;">Mã KH</th>
                            <th>Họ và tên</th>
                            <th>Số điện thoại</th>
                            <th>Email</th>
                            <th>Địa chỉ</th>
                            <th class="text-center" style="width: 150px;">Trạng thái</th>
                            <th class="text-center pe-3" style="width: 230px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DanhSachKhachHang != null && Model.DanhSachKhachHang.Any())
                        {
                            foreach (var item in Model.DanhSachKhachHang)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-secondary">#@item.MaKhachHang</td>
                                    <td class="fw-semibold">
                                        <a asp-action="Details" asp-route-id="@item.MaKhachHang" class="text-decoration-none text-dark">
                                            @item.HoTen
                                        </a>
                                    </td>
                                    <td>@item.SoDienThoai</td>
                                    <td>@(item.Email ?? "Chưa có")</td>
                                    <td>@(item.DiaChi ?? "Chưa có")</td>
                                    <td class="text-center">
                                        @if (item.TrangThai)
                                        {
                                            <span class="badge bg-success">Đang hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Bị khóa</span>
                                        }
                                    </td>
                                    <td class="text-center pe-3">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.MaKhachHang" class="btn btn-outline-info" title="Xem chi tiết">
                                                Chi tiết
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.MaKhachHang" class="btn btn-outline-primary" title="Chỉnh sửa">
                                                Sửa
                                            </a>
                                            <form asp-action="ToggleTrangThai" asp-route-id="@item.MaKhachHang" method="post" class="d-inline"
                                                  onsubmit="return confirm('Bạn có chắc chắn muốn thay đổi trạng thái của khách hàng này?');">
                                                @Html.AntiForgeryToken()
                                                @if (item.TrangThai)
                                                {
                                                    <button type="submit" class="btn btn-outline-danger" title="Khóa khách hàng">
                                                        Khóa
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-outline-success" title="Mở khóa khách hàng">
                                                        Mở khóa
                                                    </button>
                                                }
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    Không tìm thấy dữ liệu khách hàng nào phù hợp với điều kiện tìm kiếm.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Phân trang sử dụng PaginatedList (Mục 6.7 & 15 file Word) -->
        @if (Model.DanhSachKhachHang != null && Model.DanhSachKhachHang.TongSoTrang > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                <small class="text-muted">
                    Trang <strong>@Model.DanhSachKhachHang.TrangHienTai</strong> / <strong>@Model.DanhSachKhachHang.TongSoTrang</strong> 
                    (Tổng số: <strong>@Model.DanhSachKhachHang.TongSoBanGhi</strong> khách hàng)
                </small>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.DanhSachKhachHang.CoTrangTruoc ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-pageIndex="@(Model.DanhSachKhachHang.TrangHienTai - 1)"
                               asp-route-tuKhoa="@Model.TuKhoa"
                               asp-route-trangThaiFilter="@Model.TrangThaiFilter"
                               asp-route-sortOrder="@Model.SortOrder">
                                Trước
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.DanhSachKhachHang.TongSoTrang; i++)
                        {
                            <li class="page-item @(i == Model.DanhSachKhachHang.TrangHienTai ? "active" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-pageIndex="@i"
                                   asp-route-tuKhoa="@Model.TuKhoa"
                                   asp-route-trangThaiFilter="@Model.TrangThaiFilter"
                                   asp-route-sortOrder="@Model.SortOrder">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(!Model.DanhSachKhachHang.CoTrangSau ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-pageIndex="@(Model.DanhSachKhachHang.TrangHienTai + 1)"
                               asp-route-tuKhoa="@Model.TuKhoa"
                               asp-route-trangThaiFilter="@Model.TrangThaiFilter"
                               asp-route-sortOrder="@Model.SortOrder">
                                Sau
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
