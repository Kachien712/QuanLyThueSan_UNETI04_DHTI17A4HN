@* 
    Họ và tên: Khuất Anh Chiến
    Mã sinh viên: 23103100234
    Nội dung thực hiện: Module 1 - Giao diện thêm mới Khu vực (Mục 5.5 file Word)
*@
@model QuanLyThueSan_UNETI04_DHTI17A4HN.ViewModels.KhuVucFormViewModel

@{
    ViewData["Title"] = "Thêm mới Khu vực";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white py-3">
                <h5 class="card-title mb-0"><i class="bi bi-plus-circle"></i> Thêm mới Khu vực sân</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="TenKhuVuc" class="form-label fw-semibold"></label>
                        <input asp-for="TenKhuVuc" class="form-control" placeholder="Ví dụ: Khu A - Sân bóng đá trong nhà..." autofocus />
                        <span asp-validation-for="TenKhuVuc" class="text-danger small"></span>
                        <div class="form-text">Tên khu vực là duy nhất theo quy định đề tài.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ViTri" class="form-label fw-semibold"></label>
                        <input asp-for="ViTri" class="form-control" placeholder="Ví dụ: Tầng 1 Nhà thể chất, Khu ngoài trời phía Đông..." />
                        <span asp-validation-for="ViTri" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MoTa" class="form-label fw-semibold"></label>
                        <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Mô tả thông tin chi tiết về khu vực..."></textarea>
                        <span asp-validation-for="MoTa" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="TrangThai" id="flexSwitchTrangThai">
                        <label class="form-check-label fw-semibold" for="flexSwitchTrangThai">Kích hoạt hoạt động ngay</label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                        <button type="submit" class="btn btn-success px-4">Lưu khu vực</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
