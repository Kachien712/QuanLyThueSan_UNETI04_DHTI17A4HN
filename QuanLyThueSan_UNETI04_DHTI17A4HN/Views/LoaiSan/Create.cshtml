@* 
    Họ và tên: Khuất Anh Chiến
    Mã sinh viên: 23103100234
    Nội dung thực hiện: Module 1 - Giao diện thêm mới Loại sân (Mục 5.4 file Word)
*@
@model QuanLyThueSan_UNETI04_DHTI17A4HN.ViewModels.LoaiSanFormViewModel

@{
    ViewData["Title"] = "Thêm mới Loại sân";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white py-3">
                <h5 class="card-title mb-0"><i class="bi bi-plus-circle"></i> Thêm mới Loại sân thể thao</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="TenLoaiSan" class="form-label fw-semibold"></label>
                        <input asp-for="TenLoaiSan" class="form-control" placeholder="Ví dụ: Sân bóng đá 7 người, Sân Pickleball..." autofocus
                               data-kiem-tra="1" data-url="@Url.Action("KiemTraTrungTen")" data-param="ten" />
                        <span asp-validation-for="TenLoaiSan" class="text-danger small"></span>
                        <span data-thong-bao class="small"></span>
                        <div class="form-text">Tên loại sân là duy nhất trên hệ thống, không được trùng lặp.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SoNguoiToiDa" class="form-label fw-semibold"></label>
                        <input asp-for="SoNguoiToiDa" type="number" class="form-control" placeholder="Ví dụ: 14" min="1" max="100" />
                        <span asp-validation-for="SoNguoiToiDa" class="text-danger small"></span>
                        <div class="form-text">Số người tối đa tham gia trong một lượt sử dụng sân (bắt buộc > 0 nếu có nhập).</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MoTa" class="form-label fw-semibold"></label>
                        <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Mô tả đặc điểm loại sân, tiêu chuẩn mặt sân, trang thiết bị..."></textarea>
                        <span asp-validation-for="MoTa" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="TrangThai" id="flexSwitchTrangThai">
                        <label class="form-check-label fw-semibold" for="flexSwitchTrangThai">Kích hoạt hoạt động ngay</label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                        <button type="submit" class="btn btn-success px-4">Lưu loại sân</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/ajax-kiem-tra.js" asp-append-version="true"></script>
}
