@* 
    Họ và tên: Khuất Anh Chiến
    Mã sinh viên: 23103100234
    Nội dung thực hiện: Module 1 - Giao diện danh sách loại sân có tìm kiếm, lọc, phân trang và thống kê (Mục 5.4 file Word)
*@
@model QuanLyThueSan_UNETI04_DHTI17A4HN.ViewModels.LoaiSanIndexViewModel

@{
    ViewData["Title"] = "Quản lý Loại sân";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="text-primary mb-1"><i class="bi bi-tag-fill"></i> Quản lý Loại sân thể thao</h2>
            <p class="text-muted mb-0">Danh mục các môn và loại sân phục vụ cho hoạt động thuê sân</p>
        </div>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Thêm loại sân mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>Thông báo:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <strong>Lỗi:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Thống kê nhanh số lượng -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body py-2">
                    <small>Tổng số loại sân</small>
                    <h3 class="mb-0 fw-bold">@Model.TongSoLoaiSan</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body py-2">
                    <small>Đang hoạt động</small>
                    <h3 class="mb-0 fw-bold">@Model.SoLoaiSanHoatDong</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-secondary text-white">
                <div class="card-body py-2">
                    <small>Ngừng hoạt động</small>
                    <h3 class="mb-0 fw-bold">@Model.SoLoaiSanTamNgung</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Thanh Tìm kiếm và Bộ lọc -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-6">
                    <input type="text" name="tuKhoa" value="@Model.TuKhoa" class="form-control" 
                           placeholder="Tìm kiếm theo tên loại sân, mô tả..." />
                </div>
                <div class="col-md-3">
                    <select name="trangThaiFilter" asp-items="Model.DanhSachTrangThai" class="form-select"></select>
                </div>
                <div class="col-md-3 d-flex gap-1">
                    <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách Loại sân -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 80px;">Mã</th>
                            <th>Tên loại sân</th>
                            <th>Mô tả</th>
                            <th class="text-center" style="width: 150px;">Số người tối đa</th>
                            <th class="text-center" style="width: 120px;">Số sân trực thuộc</th>
                            <th class="text-center" style="width: 140px;">Trạng thái</th>
                            <th class="text-end pe-3" style="width: 220px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DanhSachLoaiSan.Any())
                        {
                            foreach (var item in Model.DanhSachLoaiSan)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-muted">#@item.MaLoaiSan</td>
                                    <td class="fw-semibold text-primary">@item.TenLoaiSan</td>
                                    <td class="text-muted small">@(string.IsNullOrWhiteSpace(item.MoTa) ? "—" : item.MoTa)</td>
                                    <td class="text-center">
                                        @(item.SoNguoiToiDa.HasValue ? $"{item.SoNguoiToiDa} người" : "Không giới hạn")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-geo-alt"></i> @item.SanTheThaos.Count sân
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.TrangThai)
                                        {
                                            <span class="badge bg-success">Đang hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Ngừng hoạt động</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@item.MaLoaiSan" class="btn btn-outline-info" title="Xem chi tiết & danh sách sân">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.MaLoaiSan" class="btn btn-outline-primary" title="Chỉnh sửa">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="DoiTrangThai" asp-route-id="@item.MaLoaiSan" method="post" class="d-inline"
                                                  onsubmit="return confirm('Bạn có chắc chắn muốn thay đổi trạng thái hoạt động của loại sân này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn @(item.TrangThai ? "btn-outline-warning" : "btn-outline-success")" 
                                                        title="@(item.TrangThai ? "Ngừng hoạt động" : "Kích hoạt lại")">
                                                    <i class="bi @(item.TrangThai ? "bi-pause-circle" : "bi-play-circle")"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    Không tìm thấy loại sân nào phù hợp với điều kiện tìm kiếm.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Phân trang LINQ Skip / Take -->
        @if (Model.DanhSachLoaiSan.TongSoTrang > 1)
        {
            <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
                <span class="small text-muted">
                    Hiển thị trang <strong>@Model.DanhSachLoaiSan.TrangHienTai</strong> / <strong>@Model.DanhSachLoaiSan.TongSoTrang</strong> 
                    (Tổng cộng @Model.DanhSachLoaiSan.TongSoBanGhi bản ghi)
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.DanhSachLoaiSan.CoTrangTruoc ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-pageIndex="@(Model.DanhSachLoaiSan.TrangHienTai - 1)"
                               asp-route-tuKhoa="@Model.TuKhoa"
                               asp-route-trangThaiFilter="@Model.TrangThaiFilter">
                                &laquo; Trước
                            </a>
                        </li>
                        @for (int i = 1; i <= Model.DanhSachLoaiSan.TongSoTrang; i++)
                        {
                            <li class="page-item @(i == Model.DanhSachLoaiSan.TrangHienTai ? "active" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-pageIndex="@i"
                                   asp-route-tuKhoa="@Model.TuKhoa"
                                   asp-route-trangThaiFilter="@Model.TrangThaiFilter">@i</a>
                            </li>
                        }
                        <li class="page-item @(!Model.DanhSachLoaiSan.CoTrangSau ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-pageIndex="@(Model.DanhSachLoaiSan.TrangHienTai + 1)"
                               asp-route-tuKhoa="@Model.TuKhoa"
                               asp-route-trangThaiFilter="@Model.TrangThaiFilter">
                                Sau &raquo;
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
