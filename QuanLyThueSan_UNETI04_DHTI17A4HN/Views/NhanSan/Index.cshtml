@*
    Họ và tên: Lê Ngọc Hải Nam
    Mã sinh viên: 23103100219
    Nội dung thực hiện: Module 4 tuần 2 - danh sách đơn đã xác nhận và nút nhận sân.
*@
@model IReadOnlyList<QuanLyThueSan_UNETI04_DHTI17A4HN.Models.DatSan>
@{ ViewData["Title"] = "Nhận sân"; }

<section class="module4-page">
    <div class="module4-hero">
        <span class="module4-eyebrow"><i class="bi bi-door-open"></i> Module 4 · Check-in</span>
        <h1>Nhận sân</h1>
        <p>Xác nhận khách đã đến để bắt đầu lượt sử dụng sân.</p>
    </div>
@if (TempData["Success"] is string success) { <div class="alert alert-success module4-alert">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger module4-alert">@error</div> }
<div class="module4-panel table-responsive">
    <table class="table module4-table align-middle mb-0">
        <thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Sân</th><th>Ngày</th><th>Giờ đặt</th><th></th></tr></thead>
        <tbody>
        @foreach (var don in Model)
        {
            <tr>
                <td><span class="module4-id">#@don.MaDatSan</span></td>
                <td>@(don.KhachHang?.HoTen ?? $"#{don.MaKhachHang}")</td>
                <td>@(don.SanTheThao?.TenSan ?? $"#{don.MaSan}")</td>
                <td>@don.NgaySuDung.ToString("dd/MM/yyyy")</td>
                <td>@don.GioBatDau.ToString(@"hh\:mm")–@don.GioKetThuc.ToString(@"hh\:mm")</td>
                <td>
                    <form asp-action="Nhan" asp-route-id="@don.MaDatSan" method="post">
                        @Html.AntiForgeryToken()
                        <button class="btn module4-btn-primary btn-sm" type="submit"><i class="bi bi-play-circle"></i> Nhận sân</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6">Không có đơn đã xác nhận.</td></tr> }
        </tbody>
    </table>
</div>
</section>
