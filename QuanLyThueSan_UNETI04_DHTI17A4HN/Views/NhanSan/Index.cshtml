@*
    Họ và tên: Lê Ngọc Hải Nam
    Mã sinh viên: 23103100219
    Nội dung thực hiện: Module 4 tuần 2 - danh sách đơn đã xác nhận và nút nhận sân.
*@
@model IReadOnlyList<QuanLyThueSan_UNETI04_DHTI17A4HN.Models.DatSan>
@{ ViewData["Title"] = "Nhận sân"; }

<h1>Nhận sân</h1>
<p>Chỉ nhận sân cho đơn đã xác nhận, vào đúng ngày sử dụng.</p>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Sân</th><th>Ngày</th><th>Giờ đặt</th><th></th></tr></thead>
        <tbody>
        @foreach (var don in Model)
        {
            <tr>
                <td>@don.MaDatSan</td>
                <td>@(don.KhachHang?.HoTen ?? $"#{don.MaKhachHang}")</td>
                <td>@(don.SanTheThao?.TenSan ?? $"#{don.MaSan}")</td>
                <td>@don.NgaySuDung.ToString("dd/MM/yyyy")</td>
                <td>@don.GioBatDau.ToString(@"hh\:mm")–@don.GioKetThuc.ToString(@"hh\:mm")</td>
                <td>
                    <form asp-action="Nhan" asp-route-id="@don.MaDatSan" method="post">
                        <button class="btn btn-primary btn-sm" type="submit">Nhận sân</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6">Không có đơn đã xác nhận.</td></tr> }
        </tbody>
    </table>
</div>
