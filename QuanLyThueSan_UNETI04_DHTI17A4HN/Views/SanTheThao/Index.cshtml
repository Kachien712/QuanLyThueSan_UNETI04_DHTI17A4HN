@* 
    Họ và tên: Đào Duy Khánh
    Mã sinh viên: 23103100220
    Nội dung thực hiện: Module 2 - Giao diện danh sách sân thể thao, tìm kiếm, bộ lọc đa tiêu chí và phân trang
*@
@model QuanLyThueSan_UNETI04_DHTI17A4HN.ViewModels.SanTheThaoIndexViewModel

@{
    ViewData["Title"] = "Quản lý Sân thể thao";
}

<div class="container-fluid py-4">
    <!-- TIÊU ĐỀ & NÚT THÊM MỚI -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-grid-3x3-gap-fill me-2"></i>QUẢN LÝ SÂN THỂ THAO
            </h2>
            <p class="text-muted mb-0">Hệ thống quản lý thông tin sân, tình trạng hoạt động và bảng giá</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Thêm sân mới
            </a>
        </div>
    </div>

    <!-- KHỐI BỘ LỌC VÀ TÌM KIẾM ĐA TIÊU CHÍ (Mục 6.4, 6.5, 6.6) -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="card-title mb-0 text-dark fw-semibold">
                <i class="bi bi-funnel-fill text-primary me-2"></i>Bộ lọc và Tìm kiếm
            </h5>
        </div>
        <div class="card-body bg-light bg-opacity-50">
            <form method="get" asp-action="Index" class="row g-3">
                <!-- 1. Từ khóa tìm kiếm (Tên sân, Loại sân, Khu vực) -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-secondary small">Từ khóa tìm kiếm</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="tuKhoa" value="@Model.TuKhoa" class="form-control" 
                               placeholder="Tìm theo tên sân, loại sân, khu vực..." />
                    </div>
                </div>

                <!-- 2. Lọc theo Loại sân -->
                <div class="col-md-2 col-sm-6">
                    <label class="form-label fw-semibold text-secondary small">Loại sân</label>
                    <select name="maLoaiSan" asp-items="Model.DanhSachLoaiSan" class="form-select">
                        <option value="">-- Tất cả loại sân --</option>
                    </select>
                </div>

                <!-- 3. Lọc theo Khu vực -->
                <div class="col-md-2 col-sm-6">
                    <label class="form-label fw-semibold text-secondary small">Khu vực</label>
                    <select name="maKhuVuc" asp-items="Model.DanhSachKhuVuc" class="form-select">
                        <option value="">-- Tất cả khu vực --</option>
                    </select>
                </div>

                <!-- 4. Lọc theo Tình trạng -->
                <div class="col-md-2 col-sm-6">
                    <label class="form-label fw-semibold text-secondary small">Tình trạng sân</label>
                    <select name="tinhTrang" asp-items="Model.DanhSachTinhTrang" class="form-select">
                        <option value="">-- Tất cả tình trạng --</option>
                    </select>
                </div>

                <!-- 5. Lọc theo Sức chứa tối thiểu -->
                <div class="col-md-2 col-sm-6">
                    <label class="form-label fw-semibold text-secondary small">Sức chứa từ</label>
                    <input type="number" name="sucChuaToiThieu" value="@Model.SucChuaToiThieu" min="1" 
                           class="form-control" placeholder="Tối thiểu..." />
                </div>

                <!-- 6. Tiêu chí Sắp xếp -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary small">Sắp xếp theo</label>
                    <select name="sortOrder" class="form-select">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.SortOrder))">Tên sân (A -> Z)</option>
                        <option value="ten_desc" selected="@(Model.SortOrder == "ten_desc")">Tên sân (Z -> A)</option>
                        <option value="succhua_asc" selected="@(Model.SortOrder == "succhua_asc")">Sức chứa tăng dần</option>
                        <option value="succhua_desc" selected="@(Model.SortOrder == "succhua_desc")">Sức chứa giảm dần</option>
                        <option value="loai_asc" selected="@(Model.SortOrder == "loai_asc")">Theo loại sân</option>
                        <option value="khuvuc_asc" selected="@(Model.SortOrder == "khuvuc_asc")">Theo khu vực</option>
                    </select>
                </div>

                <!-- Nút thao tác Lọc / Đặt lại -->
                <div class="col-md-9 d-flex align-items-end justify-content-end gap-2">
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-funnel me-1"></i> Áp dụng bộ lọc
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-3">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- DANH SÁCH SÂN VÀ THỐNG KÊ (Mục 6.3, 6.7) -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <span class="fw-semibold text-dark">
                Danh sách kết quả: <span class="badge bg-primary rounded-pill">@Model.TongSoSan sân</span>
            </span>
            <span class="text-muted small">
                Hiển thị trang @Model.TrangHienTai / @(Model.TongSoTrang == 0 ? 1 : Model.TongSoTrang)
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr>
                        <th style="width: 5%;" class="text-center text-nowrap">#</th>
                        <th style="width: 25%;">Tên sân thể thao</th>
                        <th style="width: 16%;" class="text-nowrap">Loại sân</th>
                        <th style="width: 18%;" class="text-nowrap">Khu vực</th>
                        <th style="width: 10%;" class="text-center text-nowrap">Sức chứa</th>
                        <th style="width: 12%;" class="text-center text-nowrap">Tình trạng</th>
                        <th style="width: 14%;" class="text-center text-nowrap">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DanhSachSan != null && Model.DanhSachSan.Any())
                    {
                        var stt = (Model.TrangHienTai - 1) * Model.KichThuocTrang + 1;
                        foreach (var item in Model.DanhSachSan)
                        {
                            <tr>
                                <td class="text-center text-muted fw-bold">@(stt++)</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.TenSan</div>
                                    @if (!string.IsNullOrEmpty(item.MoTa))
                                    {
                                        <div class="text-muted small text-truncate" style="max-width: 260px;" 
                                             data-bs-toggle="tooltip" data-bs-title="@item.MoTa">
                                            @item.MoTa
                                        </div>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-semibold">
                                        <i class="bi bi-tag-fill me-1 small"></i>@(item.LoaiSan?.TenLoaiSan ?? "Chưa rõ")
                                    </span>
                                </td>
                                <td class="text-nowrap">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                    <span class="fw-medium text-dark">@(item.KhuVuc?.TenKhuVuc ?? "Chưa rõ")</span>
                                </td>
                                <td class="text-center text-nowrap">
                                    <span class="fw-bold text-dark">@item.SucChua</span> <span class="text-muted small">người</span>
                                </td>
                                <td class="text-center text-nowrap">
                                    @switch (item.TinhTrang)
                                    {
                                        case "Đang hoạt động":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-check-circle me-1"></i>Đang hoạt động
                                            </span>
                                            break;
                                        case "Tạm ngừng":
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                                <i class="bi bi-pause-circle me-1"></i>Tạm ngừng
                                            </span>
                                            break;
                                        case "Đang bảo trì":
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                                <i class="bi bi-tools me-1"></i>Đang bảo trì
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                                <i class="bi bi-x-circle me-1"></i>Ngừng sử dụng
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="text-center text-nowrap">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@item.MaSan" 
                                           class="btn btn-sm btn-outline-info rounded px-2" 
                                           data-bs-toggle="tooltip" data-bs-title="Xem chi tiết sân">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.MaSan" 
                                           class="btn btn-sm btn-outline-primary rounded px-2" 
                                           data-bs-toggle="tooltip" data-bs-title="Chỉnh sửa thông tin">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-controller="BangGia" asp-action="Index" asp-route-maSan="@item.MaSan" 
                                           class="btn btn-sm btn-outline-warning rounded px-2" 
                                           data-bs-toggle="tooltip" data-bs-title="Xem & cấu hình bảng giá">
                                            <i class="bi bi-currency-dollar"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                <span>Không tìm thấy sân thể thao nào phù hợp với điều kiện tìm kiếm.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PHÂN TRANG (Mục 6.7: Dùng LINQ Skip/Take và giữ nguyên điều kiện khi chuyển trang) -->
        @if (Model.TongSoTrang > 1)
        {
            <div class="card-footer bg-white border-top py-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <div class="text-muted small">
                    Trang <strong>@Model.TrangHienTai</strong> / <strong>@Model.TongSoTrang</strong> 
                    (Tổng cộng <strong>@Model.TongSoSan</strong> sân thể thao)
                </div>
                <nav aria-label="Phân trang danh sách sân">
                    <ul class="pagination pagination-sm mb-0">
                        <!-- Nút Trang trước -->
                        <li class="page-item @(!Model.CoTrangTruoc ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageIndex="@(Model.TrangHienTai - 1)"
                               asp-route-tuKhoa="@Model.TuKhoa"
                               asp-route-maLoaiSan="@Model.MaLoaiSan"
                               asp-route-maKhuVuc="@Model.MaKhuVuc"
                               asp-route-tinhTrang="@Model.TinhTrang"
                               asp-route-sucChuaToiThieu="@Model.SucChuaToiThieu"
                               asp-route-sortOrder="@Model.SortOrder">
                                <i class="bi bi-chevron-left me-1"></i>Trước
                            </a>
                        </li>

                        <!-- Các trang số -->
                        @for (int p = 1; p <= Model.TongSoTrang; p++)
                        {
                            <li class="page-item @(p == Model.TrangHienTai ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pageIndex="@p"
                                   asp-route-tuKhoa="@Model.TuKhoa"
                                   asp-route-maLoaiSan="@Model.MaLoaiSan"
                                   asp-route-maKhuVuc="@Model.MaKhuVuc"
                                   asp-route-tinhTrang="@Model.TinhTrang"
                                   asp-route-sucChuaToiThieu="@Model.SucChuaToiThieu"
                                   asp-route-sortOrder="@Model.SortOrder">
                                    @p
                                </a>
                            </li>
                        }

                        <!-- Nút Trang sau -->
                        <li class="page-item @(!Model.CoTrangSau ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageIndex="@(Model.TrangHienTai + 1)"
                               asp-route-tuKhoa="@Model.TuKhoa"
                               asp-route-maLoaiSan="@Model.MaLoaiSan"
                               asp-route-maKhuVuc="@Model.MaKhuVuc"
                               asp-route-tinhTrang="@Model.TinhTrang"
                               asp-route-sucChuaToiThieu="@Model.SucChuaToiThieu"
                               asp-route-sortOrder="@Model.SortOrder">
                                Sau<i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Kích hoạt Bootstrap Tooltip hiển thị siêu nhanh (delay 50ms khi rê chuột)
        document.addEventListener('DOMContentLoaded', function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                new bootstrap.Tooltip(tooltipTriggerEl, {
                    delay: { show: 50, hide: 50 },
                    trigger: 'hover'
                });
            });
        });
    </script>
}
