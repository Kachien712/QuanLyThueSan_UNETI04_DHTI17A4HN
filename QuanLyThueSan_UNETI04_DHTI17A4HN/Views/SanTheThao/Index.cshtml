@* 
    Họ và tên: Đào Duy Khánh
    Mã sinh viên: 23103100220
    Nội dung thực hiện: Module 2 - Giao diện danh sách sân thể thao
    - Tìm kiếm, Lọc, Sắp xếp (Mục 6.6), Phân trang (Mục 6.7)
    - Chức năng nâng cao: Upload ảnh sân (Mục 19.1) & AJAX Live Search/Filter (Mục 19.6, Minimalism style)
*@
@model QuanLyThueSan_UNETI04_DHTI17A4HN.ViewModels.SanTheThaoIndexViewModel

@{
    ViewData["Title"] = "Quản lý sân thể thao";
}

<div class="container-fluid pt-0 pb-4">
    @if (TempData["ThanhCong"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-2 py-2 px-3 small border mb-3" role="alert">
            <strong>Thông báo:</strong> @TempData["ThanhCong"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KHỐI BỘ LỌC VÀ TÌM KIẾM (Tích hợp AJAX Live Search - Mục 19.6) -->
    <div class="border rounded-2 bg-white mb-3">
        <div class="border-bottom py-2 px-3 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-uppercase small text-muted tracking-wide">Bộ lọc và Tìm kiếm sân</span>
                <span class="badge bg-light text-dark border small fw-normal">Live AJAX</span>
            </div>
            @if (Context.Session.GetString(QuanLyThueSan_UNETI04_DHTI17A4HN.Helpers.SessionKeys.VaiTro) is "Admin" or "NhanVien")
            {
                <a asp-action="Create" class="btn btn-dark btn-sm px-3 rounded-1">
                    Thêm sân mới
                </a>
            }
        </div>
        <div class="p-3 bg-light bg-opacity-25">
            <form id="formBoLocSan" method="get" asp-action="Index" class="row g-2 align-items-end">
                <!-- Từ khóa tìm kiếm (Gõ phím là tự động tìm tức thì qua AJAX) -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small text-muted mb-1">Từ khóa (Tự động tìm kiếm)</label>
                    <input type="text" id="inputTuKhoa" name="tuKhoa" value="@Model.TuKhoa" class="form-control form-control-sm rounded-1" 
                           placeholder="Nhập tên sân, môn thể thao, khu vực..." autocomplete="off" />
                </div>

                <!-- Lọc Loại sân -->
                <div class="col-lg-2 col-md-3">
                    <label class="form-label small text-muted mb-1">Loại sân</label>
                    <select id="selectLoaiSan" name="maLoaiSan" asp-items="Model.DanhSachLoaiSan" class="form-select form-select-sm rounded-1">
                        <option value="">Tất cả loại sân</option>
                    </select>
                </div>

                <!-- Lọc Khu vực -->
                <div class="col-lg-2 col-md-3">
                    <label class="form-label small text-muted mb-1">Khu vực</label>
                    <select id="selectKhuVuc" name="maKhuVuc" asp-items="Model.DanhSachKhuVuc" class="form-select form-select-sm rounded-1">
                        <option value="">Tất cả khu vực</option>
                    </select>
                </div>

                <!-- Lọc Tình trạng -->
                <div class="col-lg-2 col-md-3">
                    <label class="form-label small text-muted mb-1">Tình trạng</label>
                    <select id="selectTinhTrang" name="tinhTrang" asp-items="Model.DanhSachTinhTrang" class="form-select form-select-sm rounded-1">
                        <option value="">Tất cả tình trạng</option>
                    </select>
                </div>

                <!-- Sắp xếp -->
                <div class="col-lg-2 col-md-3">
                    <label class="form-label small text-muted mb-1">Sắp xếp</label>
                    <select id="selectSortOrder" name="sortOrder" class="form-select form-select-sm rounded-1">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.SortOrder))">Tên sân (A - Z)</option>
                        <option value="ten_desc" selected="@(Model.SortOrder == "ten_desc")">Tên sân (Z - A)</option>
                        <option value="dongia_asc" selected="@(Model.SortOrder == "dongia_asc")">Đơn giá tăng dần (Mục 6.6)</option>
                        <option value="dongia_desc" selected="@(Model.SortOrder == "dongia_desc")">Đơn giá giảm dần (Mục 6.6)</option>
                        <option value="succhua_asc" selected="@(Model.SortOrder == "succhua_asc")">Sức chứa tăng dần</option>
                        <option value="succhua_desc" selected="@(Model.SortOrder == "succhua_desc")">Sức chứa giảm dần</option>
                        <option value="loai_asc" selected="@(Model.SortOrder == "loai_asc")">Theo loại sân</option>
                        <option value="khuvuc_asc" selected="@(Model.SortOrder == "khuvuc_asc")">Theo khu vực</option>
                    </select>
                </div>

                <!-- Nút thao tác -->
                <div class="col-lg-1 col-md-6 d-flex gap-1">
                    <button type="submit" class="btn btn-outline-dark btn-sm w-100 rounded-1" title="Lọc dữ liệu">Lọc</button>
                    <button type="button" id="btnXoaBoLoc" class="btn btn-light btn-sm border text-muted rounded-1" title="Xóa bộ lọc">Xóa</button>
                </div>
            </form>
        </div>
    </div>

    <!-- VÙNG DANH SÁCH SÂN AJAX (Mục 19.6: Cập nhật ngầm bằng AJAX) -->
    <div id="vungDanhSachSan" class="position-relative">
        <div id="ajaxSpinner" class="d-none position-absolute top-50 start-50 translate-middle bg-white px-3 py-2 rounded-2 border shadow-sm" style="z-index: 1050;">
            <div class="spinner-border spinner-border-sm text-dark align-middle me-2" role="status"></div>
            <span class="small align-middle text-muted">Đang cập nhật danh sách...</span>
        </div>
        <partial name="_DanhSachSanPartial" model="Model" />
    </div>
</div>

@section Scripts {
    <script src="~/js/san-the-thao-ajax.js" asp-append-version="true"></script>
}
