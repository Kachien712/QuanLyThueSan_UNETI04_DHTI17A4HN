<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyThueSan_UNETI04_DHTI17A4HN</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyThueSan_UNETI04_DHTI17A4HN.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">QuanLyThueSan_UNETI04_DHTI17A4HN</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold text-primary" asp-area="" asp-controller="KhachHang" asp-action="Index">Quản lý Khách hàng</a>
                        </li>
                        <!-- Menu Quản lý Đặt sân (Dropdown gom nhóm các chức năng) -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark fw-bold text-success" href="#" id="datSanDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Quản lý Đặt sân
                            </a>
                            <ul class="dropdown-menu shadow-sm" aria-labelledby="datSanDropdown">
                                <li>
                                    <a class="dropdown-item" asp-controller="DatSan" asp-action="Index">
                                        📋 Danh sách đặt sân
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="DatSan" asp-action="TimSanTrong">
                                        🔍 Tra cứu &amp; Tìm sân trống
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-success fw-bold" asp-controller="DatSan" asp-action="Create">
                                        ➕ Đặt sân mới
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Chính sách</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - QuanLyThueSan_UNETI04_DHTI17A4HN - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
