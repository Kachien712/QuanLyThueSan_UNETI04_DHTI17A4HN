@* Họ và tên: Trần Văn Lợi
   Mã sinh viên: 23103100237
   Nội dung thực hiện: Module 5 - Điều hướng thanh toán, lịch sử, Dashboard và thống kê *@
@*
    Họ và tên: Khuất Anh Chiến - MSSV: 23103100234 (Module 1 - Trạng thái đăng nhập/đăng xuất, Quản lý tài khoản, Loại sân, Khu vực)
    Đào Duy Khánh - MSSV: 23103100220 (Module 2 - Điều hướng Sân thể thao & Giao diện tối giản)
    Đào Đức Kiên - MSSV: 23103100222 (Module 3 - Điều hướng Lịch sử đặt sân & Hồ sơ cá nhân của khách hàng)
    Lê Ngọc Hải Nam - MSSV: 23103100219 (Module 4 - Bổ sung liên kết nhận sân và quản lý dịch vụ)
    Khuất Anh Chiến - MSSV: 23103100234 (Module 4 - Bổ sung liên kết xác nhận đặt sân)
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyThueSan_UNETI04_DHTI17A4HN</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyThueSan_UNETI04_DHTI17A4HN.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-2">
            <div class="container">
                <a class="navbar-brand fw-bold text-dark fs-5 tracking-wide me-4" asp-area="" asp-controller="Home" asp-action="Index">
                    QUẢN LÝ THUÊ SÂN
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 text-secondary fw-medium rounded" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 text-dark fw-semibold rounded" asp-area="" asp-controller="SanTheThao" asp-action="Index">Quản lý sân thể thao</a>
                        </li>
                        <!-- Menu Quản lý Đặt sân (Dropdown gom nhóm các chức năng) -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark fw-bold text-success" href="#" id="datSanDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Quản lý Đặt sân
                            </a>
                            <ul class="dropdown-menu shadow-sm" aria-labelledby="datSanDropdown">
                                <li>
                                    <a class="dropdown-item" asp-controller="DatSan" asp-action="LichSuDatSan">
                                        📋 Lịch sử đặt sân
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="DatSan" asp-action="TimSanTrong">
                                        🔍 Tra cứu &amp; Tìm sân trống
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-success fw-bold" asp-controller="DatSan" asp-action="Create">
                                        ➕ Đặt sân mới
                                    </a>
                                </li>
                            </ul>
                        </li>
                        @if (Context.Session.GetString(SessionKeys.VaiTro) is "Admin" or "NhanVien")
                        {
                            <!-- Menu Danh mục sân (Loại sân & Khu vực - Module 1) -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-medium" href="#" id="danhMucSanDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Danh mục sân
                                </a>
                                <ul class="dropdown-menu shadow-sm" aria-labelledby="danhMucSanDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="LoaiSan" asp-action="Index">
                                            <i class="bi bi-tag-fill text-primary me-2"></i> Quản lý Loại sân
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="KhuVuc" asp-action="Index">
                                            <i class="bi bi-geo-alt-fill text-success me-2"></i> Quản lý Khu vực
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2 text-secondary fw-medium rounded" asp-area="" asp-controller="KhachHang" asp-action="Index">Quản lý Khách hàng</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="XacNhanDatSan" asp-action="Index">Xác nhận đặt sân</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="NhanSan" asp-action="Index">Nhận sân</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="DichVu" asp-action="Index">Dịch vụ</a>
                            </li>
                            @if (Context.Session.GetString(SessionKeys.VaiTro) == "Admin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="TaiKhoan" asp-action="Index">
                                        Quản lý tài khoản
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="ThanhToan" asp-action="ChoThanhToan">Thanh toán</a>
                            </li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="ThongKe" asp-action="Index">Thống kê</a></li>
                        }
                        @if (Context.Session.GetString(SessionKeys.VaiTro) == "KhachHang")
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="LichSu" asp-action="CuaToi">Lịch sử của tôi</a></li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2 text-secondary fw-medium rounded" asp-controller="DatSan" asp-action="LichSuDatSan">Lịch sử đặt sân</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 text-secondary fw-medium rounded" asp-area="" asp-controller="Home" asp-action="Privacy">Chính sách</a>
                        </li>
                    </ul>
                    @{
                        var hoTen = Context.Session.GetString(SessionKeys.HoTen);
                        var vaiTro = Context.Session.GetString(SessionKeys.VaiTro);
                    }
                    <ul class="navbar-nav">
                        @if (!string.IsNullOrEmpty(hoTen))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-semibold" href="#" id="userMenuDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle text-primary"></i> Xin chào, <strong>@hoTen</strong> (@vaiTro)
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenuDropdown">
                                    @if (vaiTro == "KhachHang")
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="KhachHang" asp-action="HoSoCaNhan">
                                                <i class="bi bi-person-badge me-2 text-primary"></i> Hồ sơ cá nhân
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item" asp-controller="DatSan" asp-action="LichSuDatSan">
                                            <i class="bi bi-clock-history me-2 text-info"></i> Lịch sử đặt sân
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post" class="px-2">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                                <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="TaiKhoan" asp-action="DangKy">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - QuanLyThueSan_UNETI04_DHTI17A4HN - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
