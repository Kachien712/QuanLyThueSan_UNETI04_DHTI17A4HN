@* Họ và tên: Trần Văn Lợi
   Mã sinh viên: 23103100237
   Nội dung thực hiện: Module 5 - Bảng lịch sử dùng chung cho sân và khách hàng đăng nhập *@
@model IEnumerable<QuanLyThueSan_UNETI04_DHTI17A4HN.Models.DatSan>
<div class="table-responsive"><table class="table table-hover align-middle">
    <thead><tr><th>Mã đơn</th><th>Sân</th><th>Khách hàng</th><th>Ngày</th><th>Giờ</th><th>Trạng thái</th><th>Dịch vụ</th><th>Tiền sân</th><th>Tiền dịch vụ</th><th>Tổng tiền</th></tr></thead>
    <tbody>
    @foreach (var don in Model.OrderByDescending(d => d.NgaySuDung).ThenByDescending(d => d.MaDatSan))
    {
        <tr><td>#@don.MaDatSan</td><td>@don.SanTheThao?.TenSan</td><td>@don.KhachHang?.HoTen</td><td>@don.NgaySuDung.ToString("dd/MM/yyyy")</td><td>@don.GioBatDau.ToString(@"hh\:mm") – @don.GioKetThuc.ToString(@"hh\:mm")</td><td>@don.TrangThai</td><partial name="_LichSuTienDichVu" model="don" /></tr>
    }
    @if (!Model.Any()) { <tr><td colspan="10" class="text-center text-muted">Chưa có lịch sử.</td></tr> }
    </tbody>
</table></div>
