@*
    Họ và tên: Lê Ngọc Hải Nam
    Mã sinh viên: 23103100219
    Nội dung thực hiện: Module 4 tuần 4 - Quản lý dịch vụ và chủ động kết thúc lượt sân.
*@
@model QuanLyThueSan_UNETI04_DHTI17A4HN.ViewModels.SuDungDichVuChiTietViewModel
@{ ViewData["Title"] = "Quản lý đơn #" + Model.Don.MaDatSan; }

<section class="module4-page">
<div class="module4-hero module4-hero-compact">
    <span class="module4-eyebrow"><i class="bi bi-cart-plus"></i> Đơn #@Model.Don.MaDatSan · Đang sử dụng</span>
    <h1>Quản lý lượt sân</h1>
    <p>Khách hàng: <strong>@(Model.Don.KhachHang?.HoTen ?? $"#{Model.Don.MaKhachHang}")</strong> · Sân: <strong>@(Model.Don.SanTheThao?.TenSan ?? $"#{Model.Don.MaSan}")</strong></p>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<h2 class="h4 mt-4">Thêm dịch vụ</h2>
<form asp-action="Them" asp-route-id="@Model.Don.MaDatSan" method="post" class="module4-form-card row g-2 align-items-end mb-4">
    @Html.AntiForgeryToken()
    <div class="col-md-6">
        <label for="maDichVu" class="form-label">Dịch vụ</label>
        <select id="maDichVu" name="MaDichVu" class="form-select" required>
            <option value="">Chọn dịch vụ</option>
            @foreach (var dichVu in Model.DanhMuc)
            {
                <option value="@dichVu.MaDichVu">@dichVu.TenDichVu - @dichVu.DonGia.ToString("N0") đ / @dichVu.DonViTinh (tồn: @(dichVu.SoLuongTon?.ToString() ?? "không quản lý"))</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label for="soLuong" class="form-label">Số lượng</label>
        <input id="soLuong" name="SoLuong" type="number" min="1" max="1000" value="1" required class="form-control" />
    </div>
    <div class="col-md-2"><button type="submit" class="btn module4-btn-primary w-100" disabled="@(Model.DanhMuc.Count == 0)">Ghi nhận</button></div>
</form>
@if (Model.DanhMuc.Count == 0) { <p class="text-muted">Không có dịch vụ đang hoạt động và còn số lượng.</p> }

<h2 class="h4">Dịch vụ đã ghi nhận</h2>
<div class="module4-panel table-responsive">
    <table class="table module4-table align-middle mb-0">
        <thead><tr><th>Dịch vụ</th><th>Số lượng</th><th>Đơn giá lúc dùng</th><th>Thành tiền</th><th>Thời điểm thêm</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model.PhatSinh)
        {
            <tr>
                <td>@(item.DichVu?.TenDichVu ?? $"#{item.MaDichVu}")</td>
                <td>@item.SoLuong</td>
                <td>@item.DonGia.ToString("N0") đ</td>
                <td>@item.ThanhTien.ToString("N0") đ</td>
                <td>@item.ThoiGianThem.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <form asp-action="Xoa" asp-route-id="@Model.Don.MaDatSan" method="post" onsubmit="return confirm('Xóa dòng dịch vụ này và hoàn lại tồn kho?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maSuDung" value="@item.MaSuDung" />
                        <button type="submit" class="btn module4-btn-reject btn-sm">Xóa</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.PhatSinh.Count == 0) { <tr><td colspan="6">Đơn chưa sử dụng dịch vụ.</td></tr> }
        </tbody>
        <tfoot><tr><th colspan="3" class="text-end">Tổng tiền dịch vụ</th><th>@Model.TongTienDichVu.ToString("N0") đ</th><td colspan="2"></td></tr></tfoot>
    </table>
</div>
<div class="d-flex flex-wrap gap-2 mt-3">
    <form asp-action="KetThucSan" asp-route-id="@Model.Don.MaDatSan" method="post" onsubmit="return confirm('Kết thúc lượt sân? Sau thao tác này đơn sẽ chuyển sang Module 5 để thanh toán và không thể thêm dịch vụ nữa.');">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn module4-btn-confirm"><i class="bi bi-cash-coin"></i> Kết thúc sân &amp; chuyển thanh toán</button>
    </form>
    <a asp-action="Index" class="btn module4-btn-outline">Quay lại danh sách đơn</a>
</div>
</section>
