@* 
    Họ và tên: Khuất Anh Chiến
    Mã sinh viên: 23103100234
    Nội dung thực hiện: Module 1 - Giao diện khởi tạo tài khoản hệ thống cho Admin (Mục 5.1 - 5.3 file Word)
*@
@model QuanLyThueSan_UNETI04_DHTI17A4HN.ViewModels.TaiKhoanCreateViewModel

@{
    ViewData["Title"] = "Thêm mới Tài khoản";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white py-3">
                <h5 class="card-title mb-0"><i class="bi bi-person-plus-fill"></i> Khởi tạo Tài khoản người dùng</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="TenDangNhap" class="form-label fw-semibold"></label>
                        <input asp-for="TenDangNhap" class="form-control" placeholder="Ví dụ: nhanvien_ca1, quanly_san..." autofocus
                               data-kiem-tra="1" data-url="@Url.Action("KiemTraTaiKhoan")" data-param="giaTri" data-truong="TenDangNhap" />
                        <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                        <span data-thong-bao class="small"></span>
                        <div class="form-text">Tên đăng nhập bắt buộc và không được trùng lặp.</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MatKhau" class="form-label fw-semibold"></label>
                            <input asp-for="MatKhau" class="form-control" placeholder="Tối thiểu 6 ký tự" />
                            <span asp-validation-for="MatKhau" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="XacNhanMatKhau" class="form-label fw-semibold"></label>
                            <input asp-for="XacNhanMatKhau" class="form-control" placeholder="Nhập lại mật khẩu" />
                            <span asp-validation-for="XacNhanMatKhau" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HoTen" class="form-label fw-semibold"></label>
                        <input asp-for="HoTen" class="form-control" placeholder="Họ và tên đầy đủ..." />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="Ví dụ: nhanvien@quanyttt.edu.vn"
                               data-kiem-tra="1" data-url="@Url.Action("KiemTraTaiKhoan")" data-param="giaTri" data-truong="Email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                        <span data-thong-bao class="small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="VaiTro" class="form-label fw-semibold"></label>
                        <select asp-for="VaiTro" class="form-select">
                            <option value="NhanVien">Nhân viên trực sân (NhanVien)</option>
                            <option value="Admin">Quản trị viên (Admin)</option>
                            <option value="KhachHang">Khách hàng (KhachHang)</option>
                        </select>
                        <span asp-validation-for="VaiTro" class="text-danger small"></span>
                    </div>

                    <div class="mb-3" id="groupSoDienThoai">
                        <label asp-for="SoDienThoai" class="form-label fw-semibold"></label>
                        <input asp-for="SoDienThoai" class="form-control" placeholder="Ví dụ: 0987654321" />
                        <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="TrangThai" id="flexSwitchTrangThai">
                        <label class="form-check-label fw-semibold" for="flexSwitchTrangThai">Kích hoạt tài khoản ngay</label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                        <button type="submit" class="btn btn-success px-4">Khởi tạo tài khoản</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/ajax-kiem-tra.js" asp-append-version="true"></script>
}
