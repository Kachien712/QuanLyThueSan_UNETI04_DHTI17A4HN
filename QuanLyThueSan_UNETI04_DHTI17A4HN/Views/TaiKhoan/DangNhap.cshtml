@*
    Họ và tên: Khuất Anh Chiến
    Mã sinh viên: 23103100234
    Nội dung thực hiện: Module 1 - Giao diện đăng nhập
*@
@model QuanLyThueSan_UNETI04_DHTI17A4HN.ViewModels.DangNhapViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="card-title mb-0">Đăng nhập hệ thống</h5>
            </div>
            <div class="card-body p-4">
                @if (Context.Request.Query["biKhoa"] == "1")
                {
                    <div class="alert alert-warning" role="alert">
                        Tài khoản của bạn đã bị khóa hoặc không còn tồn tại. Vui lòng liên hệ quản trị viên.
                    </div>
                }

                <form asp-action="DangNhap" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="TenDangNhap" class="form-label fw-semibold"></label>
                        <input asp-for="TenDangNhap" class="form-control" autofocus placeholder="Nhập tên đăng nhập..." />
                        <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MatKhau" class="form-label fw-semibold"></label>
                        <input asp-for="MatKhau" class="form-control" placeholder="Nhập mật khẩu..." />
                        <span asp-validation-for="MatKhau" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">Đăng nhập</button>
                </form>
                <hr />
                <p class="mb-0 text-center small">
                    Chưa có tài khoản? <a asp-action="DangKy">Đăng ký ngay</a>
                </p>
            </div>
        </div>

        <div class="card shadow-sm border-0 mt-3">
            <div class="card-body py-3 px-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-semibold text-muted">
                        <i class="bi bi-key text-warning me-1"></i> Tài khoản dùng thử
                    </span>
                    <span class="badge bg-light text-dark border fw-normal">MK: 123456</span>
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <button type="button" class="btn btn-sm btn-outline-primary w-100 text-start demo-account"
                                data-ten="admin" data-mat-khau="123456">
                            <span class="d-block fw-semibold">Admin</span>
                            <small class="text-muted">admin</small>
                        </button>
                    </div>
                    <div class="col-6">
                        <button type="button" class="btn btn-sm btn-outline-info w-100 text-start demo-account"
                                data-ten="nhanvien" data-mat-khau="123456">
                            <span class="d-block fw-semibold">Nhân viên</span>
                            <small class="text-muted">nhanvien</small>
                        </button>
                    </div>
                    <div class="col-6">
                        <button type="button" class="btn btn-sm btn-outline-success w-100 text-start demo-account"
                                data-ten="nguyenvanan@gmail.com" data-mat-khau="123456">
                            <span class="d-block fw-semibold">Khách hàng</span>
                            <small class="text-muted text-truncate d-block">nguyenvanan@gmail.com</small>
                        </button>
                    </div>
                    <div class="col-6">
                        <button type="button" class="btn btn-sm btn-outline-secondary w-100 text-start demo-account"
                                data-ten="phamquangdung@gmail.com" data-mat-khau="123456">
                            <span class="d-block fw-semibold">Khách hàng (bị khóa)</span>
                            <small class="text-muted text-truncate d-block">phamquangdung@gmail.com</small>
                        </button>
                    </div>
                </div>
                <p class="text-muted small mb-0 mt-2">
                    <i class="bi bi-info-circle me-1"></i> Bấm vào tài khoản để tự điền, sau đó bấm Đăng nhập.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.querySelectorAll('.demo-account').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var tenDangNhap = document.getElementById('TenDangNhap');
                var matKhau = document.getElementById('MatKhau');
                if (!tenDangNhap || !matKhau) {
                    return;
                }
                tenDangNhap.value = btn.getAttribute('data-ten');
                matKhau.value = btn.getAttribute('data-mat-khau');
                tenDangNhap.dispatchEvent(new Event('input', { bubbles: true }));
                matKhau.dispatchEvent(new Event('input', { bubbles: true }));
                matKhau.focus();
            });
        });
    </script>
}
