@*
    Họ và tên: Khuất Anh Chiến
    Mã sinh viên: 23103100234
    Nội dung thực hiện: Module 1 - Trang thông báo từ chối truy cập
*@
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Truy cập bị từ chối";
    var daDangNhap = Context.Session.GetInt32(QuanLyThueSan_UNETI04_DHTI17A4HN.Helpers.SessionKeys.MaTaiKhoan) is not null;
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-0">
            <div class="card-body p-5">
                @if (!daDangNhap)
                {
                    <h4 class="text-warning mb-3">Vui lòng đăng nhập</h4>
                    <p class="text-muted">Bạn cần đăng nhập để sử dụng chức năng này.</p>
                    <a asp-action="DangNhap" class="btn btn-primary">Đăng nhập</a>
                }
                else
                {
                    <h4 class="text-danger mb-3">403 - Không có quyền truy cập</h4>
                    <p class="text-muted">Tài khoản của bạn không có quyền thực hiện chức năng này.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Về trang chủ</a>
                }
            </div>
        </div>
    </div>
</div>
