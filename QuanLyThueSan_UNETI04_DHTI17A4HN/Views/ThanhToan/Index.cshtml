@* Họ và tên: Trần Văn Lợi
   Mã sinh viên: 23103100237
   Nội dung thực hiện: Module 5 - Danh sách hóa đơn đã thanh toán *@
@model QuanLyThueSan_UNETI04_DHTI17A4HN.ViewModels.ThanhToanIndexViewModel
@{ ViewData["Title"] = "Hóa đơn đã thanh toán"; }
<div class="d-flex justify-content-between mb-3"><h2>Hóa đơn đã thanh toán</h2><a asp-action="ChoThanhToan" class="btn btn-primary">Đơn chờ thanh toán</a></div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input asp-for="TuKhoa" placeholder="Tìm theo tên khách hàng" aria-label="Tên khách hàng" class="form-control" /></div>
    <div class="col-md-3"><select asp-for="PhuongThuc" aria-label="Phương thức" class="form-select"><option value="">Tất cả phương thức</option><option>Tiền mặt</option><option>Chuyển khoản</option></select></div>
    <div class="col-md-3"><select asp-for="SortOrder" aria-label="Sắp xếp" class="form-select"><option value="">Mới nhất</option><option value="ngay_asc">Cũ nhất</option><option value="tien_asc">Tổng tiền tăng dần</option><option value="tien_desc">Tổng tiền giảm dần</option><option value="khach">Tên khách hàng</option></select></div>
    <input asp-for="PageSize" type="hidden" /><div class="col-md-2"><button class="btn btn-primary">Tìm kiếm</button></div>
</form>
<div class="table-responsive"><table class="table table-striped align-middle">
    <thead><tr><th>Hóa đơn / đơn</th><th>Khách hàng</th><th>Sân</th><th>Ngày thanh toán</th><th>Phương thức</th><th>Tiền sân</th><th>Dịch vụ</th><th>Tổng tiền</th></tr></thead>
    <tbody>
    @foreach (var t in Model.DanhSach)
    {
        <tr><td>#@t.MaThanhToan / #@t.MaDatSan</td><td>@t.DatSan?.KhachHang?.HoTen</td><td>@t.DatSan?.SanTheThao?.TenSan</td><td>@t.NgayThanhToan?.ToString("dd/MM/yyyy HH:mm")</td><td>@t.PhuongThucThanhToan</td><td>@t.TienSan.ToString("N0") đ</td><td>@t.TienDichVu.ToString("N0") đ</td><td class="fw-bold">@t.TongTien.ToString("N0") đ</td></tr>
    }
    @if (Model.DanhSach.Count == 0) { <tr><td colspan="8" class="text-center">Không có hóa đơn phù hợp.</td></tr> }
    </tbody>
</table></div>
<div class="d-flex gap-3 align-items-center">
    <span>Trang @Model.DanhSach.TrangHienTai / @Math.Max(1, Model.DanhSach.TongSoTrang) (@Model.DanhSach.TongSoBanGhi hóa đơn)</span>
    @if (Model.DanhSach.CoTrangTruoc) { <a asp-route-pageIndex="@(Model.DanhSach.TrangHienTai - 1)" asp-route-tuKhoa="@Model.TuKhoa" asp-route-phuongThuc="@Model.PhuongThuc" asp-route-sortOrder="@Model.SortOrder" asp-route-pageSize="@Model.PageSize">Trang trước</a> }
    @if (Model.DanhSach.CoTrangSau) { <a asp-route-pageIndex="@(Model.DanhSach.TrangHienTai + 1)" asp-route-tuKhoa="@Model.TuKhoa" asp-route-phuongThuc="@Model.PhuongThuc" asp-route-sortOrder="@Model.SortOrder" asp-route-pageSize="@Model.PageSize">Trang sau</a> }
</div>
