@*
    Họ và tên: Lê Ngọc Hải Nam
    Mã sinh viên: 23103100219
    Nội dung thực hiện: Module 4 tuần 1 - giao diện xác nhận hoặc từ chối đơn chờ.
*@
@model IReadOnlyList<QuanLyThueSan_UNETI04_DHTI17A4HN.Models.DatSan>
@{ ViewData["Title"] = "Xác nhận đặt sân"; }

<h1>Xác nhận đặt sân</h1>
<p>Kiểm tra lại sân, lịch và giá trước khi xác nhận đơn.</p>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Sân</th><th>Ngày</th><th>Giờ</th><th>Thao tác</th></tr></thead>
        <tbody>
        @foreach (var don in Model)
        {
            <tr>
                <td>@don.MaDatSan</td>
                <td>@(don.KhachHang?.HoTen ?? $"#{don.MaKhachHang}")</td>
                <td>@(don.SanTheThao?.TenSan ?? $"#{don.MaSan}")</td>
                <td>@don.NgaySuDung.ToString("dd/MM/yyyy")</td>
                <td>@don.GioBatDau.ToString(@"hh\:mm")–@don.GioKetThuc.ToString(@"hh\:mm")</td>
                <td>
                    <form asp-action="XacNhan" asp-route-id="@don.MaDatSan" method="post" class="mb-2">
                        <button class="btn btn-success btn-sm" type="submit">Xác nhận</button>
                    </form>
                    <form asp-action="TuChoi" asp-route-id="@don.MaDatSan" method="post" class="d-flex gap-1">
                        <input name="lyDo" class="form-control form-control-sm" aria-label="Lý do từ chối" placeholder="Lý do từ chối" maxlength="450" required />
                        <button class="btn btn-outline-danger btn-sm" type="submit">Từ chối</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6">Không có đơn chờ xác nhận.</td></tr> }
        </tbody>
    </table>
</div>
