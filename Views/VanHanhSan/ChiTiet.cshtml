@*
    Họ và tên: Lê Ngọc Hải Nam
    Mã sinh viên: 23103100219
    Nội dung thực hiện: Màn hình xử lý vòng đời đơn và hiển thị dịch vụ đã sử dụng.
*@
@using QuanLyThueSan_UNETI04_DHTI17A4HN.Models.Enums
@model QuanLyThueSan_UNETI04_DHTI17A4HN.ViewModels.VanHanhDatSanViewModel
@{
    ViewData["Title"] = $"Đơn #{Model.MaDatSan}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Đơn đặt sân #@Model.MaDatSan</h1>
        <p class="text-muted mb-0">@Model.TenSan - @Model.NgaySuDung.ToString("dd/MM/yyyy") - @Model.GioBatDau.ToString("HH:mm") đến @Model.GioKetThuc.ToString("HH:mm")</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Quay lại danh sách</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="alert">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<dl class="row mb-4">
    <dt class="col-sm-3">Khách hàng</dt><dd class="col-sm-9">#@Model.MaKhachHang</dd>
    <dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9"><span class="badge text-bg-secondary">@Model.TrangThai</span></dd>
    @if (Model.ThoiDiemNhanThucTe.HasValue)
    {
        <dt class="col-sm-3">Nhận sân thực tế</dt><dd class="col-sm-9">@Model.ThoiDiemNhanThucTe.Value.ToString("dd/MM/yyyy HH:mm")</dd>
    }
    @if (Model.ThoiDiemTraThucTe.HasValue)
    {
        <dt class="col-sm-3">Trả sân thực tế</dt><dd class="col-sm-9">@Model.ThoiDiemTraThucTe.Value.ToString("dd/MM/yyyy HH:mm")</dd>
    }
    @if (!string.IsNullOrWhiteSpace(Model.LyDoTuChoi))
    {
        <dt class="col-sm-3">Lý do từ chối</dt><dd class="col-sm-9 text-danger">@Model.LyDoTuChoi</dd>
    }
</dl>

<div class="d-flex flex-wrap gap-2 mb-4">
    @if (Model.TrangThai == TrangThaiDatSan.ChoXacNhan)
    {
        <form asp-action="XacNhan" asp-route-id="@Model.MaDatSan" method="post">
            <button class="btn btn-success" type="submit">Xác nhận đơn</button>
        </form>
        <form asp-action="TuChoi" asp-route-id="@Model.MaDatSan" method="post" class="d-flex gap-2">
            <input class="form-control" name="lyDo" maxlength="500" placeholder="Lý do từ chối" required />
            <button class="btn btn-outline-danger" type="submit">Từ chối</button>
        </form>
    }
    @if (Model.TrangThai == TrangThaiDatSan.DaXacNhan)
    {
        <form asp-action="NhanSan" asp-route-id="@Model.MaDatSan" method="post">
            <button class="btn btn-primary" type="submit">Nhận sân</button>
        </form>
    }
    @if (Model.TrangThai == TrangThaiDatSan.DangSuDung)
    {
        <a class="btn btn-outline-primary" asp-action="ThemDichVu" asp-route-id="@Model.MaDatSan">Thêm dịch vụ</a>
        <form asp-action="TraSan" asp-route-id="@Model.MaDatSan" method="post">
            <button class="btn btn-warning" type="submit">Trả sân</button>
        </form>
    }
</div>

<h2 class="h5">Dịch vụ đã sử dụng</h2>
<div class="table-responsive">
    <table class="table table-sm">
        <thead class="table-light"><tr><th>Dịch vụ</th><th>Thời gian thêm</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead>
        <tbody>
        @if (!Model.DichVuDaDung.Any())
        {
            <tr><td colspan="5" class="text-center text-muted py-3">Chưa có dịch vụ phát sinh.</td></tr>
        }
        else
        {
            @foreach (var dichVu in Model.DichVuDaDung)
            {
                <tr>
                    <td>@dichVu.TenDichVu (@dichVu.DonViTinh)</td>
                    <td>@dichVu.ThoiGianThem.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@dichVu.SoLuong</td>
                    <td>@dichVu.DonGia.ToString("N0") đ</td>
                    <td>@dichVu.ThanhTien.ToString("N0") đ</td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
