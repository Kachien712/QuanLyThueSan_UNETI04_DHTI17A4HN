@*
    Họ và tên: Lê Ngọc Hải Nam
    Mã sinh viên: 23103100219
    Nội dung thực hiện: Danh sách nghiệp vụ xác nhận, nhận/trả sân và lọc đơn theo trạng thái.
*@
@using QuanLyThueSan_UNETI04_DHTI17A4HN.Models.Enums
@model IReadOnlyList<QuanLyThueSan_UNETI04_DHTI17A4HN.ViewModels.VanHanhDatSanViewModel>
@{
    ViewData["Title"] = "Vận hành sân";
    var trangThaiDangLoc = ViewBag.TrangThaiDangLoc as TrangThaiDatSan?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Vận hành sân</h1>
        <p class="text-muted mb-0">Xác nhận đơn, nhận/trả sân và theo dõi dịch vụ phát sinh.</p>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="alert">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-4 col-md-3">
        <label class="form-label" for="trangThai">Trạng thái đơn</label>
        <select class="form-select" id="trangThai" name="trangThai">
            <option value="">Tất cả trạng thái</option>
            @foreach (var trangThai in Enum.GetValues<TrangThaiDatSan>())
            {
                <option value="@trangThai" selected="@(trangThaiDangLoc == trangThai ? "selected" : null)">@trangThai</option>
            }
        </select>
    </div>
    <div class="col-sm-2 d-flex align-items-end">
        <button class="btn btn-primary w-100" type="submit">Lọc</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Mã đơn</th>
                <th>Sân</th>
                <th>Ngày sử dụng</th>
                <th>Khung giờ</th>
                <th>Trạng thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center text-muted py-4">Chưa có đơn phù hợp.</td></tr>
        }
        else
        {
            @foreach (var datSan in Model)
            {
                <tr>
                    <td>#@datSan.MaDatSan</td>
                    <td>@datSan.TenSan</td>
                    <td>@datSan.NgaySuDung.ToString("dd/MM/yyyy")</td>
                    <td>@datSan.GioBatDau.ToString("HH:mm") - @datSan.GioKetThuc.ToString("HH:mm")</td>
                    <td><span class="badge text-bg-secondary">@datSan.TrangThai</span></td>
                    <td class="text-end"><a class="btn btn-outline-primary btn-sm" asp-action="ChiTiet" asp-route-id="@datSan.MaDatSan">Xử lý</a></td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
